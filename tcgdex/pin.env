# Inputs of the next catalog release, together with assets-index.json.gz.
# Values are recorded by hand; never resolve them from a moving branch.
# The revision is not set here: prepare.sh uses the UTC build time.
#
# TCGDEX_REPO          Upstream repository URL
# TCGDEX_TAG           Upstream release tag; empty for a snapshot
# TCGDEX_BASE_TAG      Ancestor release tag for a snapshot; empty for a release
# TCGDEX_COMMIT        Full 40 character source commit, required in both modes
# UTIL_TS_SHA256       sha256 of server/compiler/utils/util.ts at that commit,
#                      checked before util.ts.patch is applied
# BUILDER_IMAGE        Base container image the compile runs on, recorded by
#                      digest, not by tag; builder.Dockerfile adds git to it
# BUILDER_VERSION      Identifier of this preparation recipe, written into the
#                      archive; bump it whenever the patch or a build step
#                      changes
# ASSETS_INDEX_URL     The one CDN input the compiler needs; make capture-assets
#                      downloads it into assets-index.json.gz
# RELEASE_TAG          Empty to derive someone-s-pc-catalog-<version>, with
#                      -<first 12 commit characters> for a snapshot.
#                      Set that name with -v2, -v3 for our corrections using
#                      the same source commit

TCGDEX_REPO="https://github.com/tcgdex/cards-database.git"
TCGDEX_TAG=""
TCGDEX_BASE_TAG="v2.49.0"
TCGDEX_COMMIT="4218f64dcbf3de6e7b7548530f938fb0b9ebbe2a"
UTIL_TS_SHA256="c016791286a7cbb0ba657a16693248f93589fd66657aca1eb607d7bf0aeabec5"
BUILDER_IMAGE="docker.io/oven/bun@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f"
BUILDER_VERSION="tcgdexv2/10"
ASSETS_INDEX_URL="https://assets.tcgdex.net/datas.json"
RELEASE_TAG=""
